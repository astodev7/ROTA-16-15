PORT=3000
NODE_ENV=development

# URL do frontend/backend público. Em produção use HTTPS e domínio real.
PUBLIC_BASE_URL=https://seu-dominio.com.br
CORS_ORIGIN=https://seu-dominio.com.br

# Senha do painel admin. Gere com:
# node -e "console.log(require('bcryptjs').hashSync('SUA_SENHA', 12))"
ADMIN_PASSWORD_HASH=

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Mercado Pago Checkout Pro
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Opcional: se quiser usar uma URL diferente do PUBLIC_BASE_URL/api/payments/webhook
MERCADOPAGO_NOTIFICATION_URL=
